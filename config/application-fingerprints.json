{
  "schemaVersion": "1.0.0",
  "description": "Application fingerprints for MSP/server-migration scoping. Each fingerprint declares matchers evaluated against normalized datasets. A fingerprint matches when one or more matchers hit; confidence rises with the number and strength of matchers. This file is intended to be edited and extended over time.",
  "confidenceModel": {
    "oneWeakMatch": "Possible",
    "oneStrongMatch": "Likely",
    "multipleMatches": "Confirmed",
    "strongSources": ["Services", "InstalledApplications", "SqlInstances", "IisSites"],
    "weakSources": ["RunningProcesses", "ListeningPorts", "ConfigDependencyHints", "CriticalPaths", "OdbcDsns"]
  },

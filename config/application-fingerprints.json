      "applicationName": "Microsoft SQL Server",
      "vendor": "Microsoft",
      "category": "Database",
      "likelyDependencyType": "Database Engine",
      "potentialProjectImpact": ["Data Migration", "Labor", "Licensing", "Cutover Complexity"],
      "suggestedValidationQuestion": "Which applications depend on this SQL Server, and is there a documented backup and recovery process for its databases?",
